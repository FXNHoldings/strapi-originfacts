.npm/
ops/data/

# Local tooling: a symlink to /opt/scripts/originfacts on the build host.
# Absolute and machine-specific, so it dangles anywhere else — on Vercel it
# made `next build` fail with ENOENT stat /vercel/path0/scripts.
scripts

# Editor swap files
.*.swp

# Stage 1 capture archive — large, and reproducible by re-running the fetcher.
# Excluded per-entry, not as a directory: git cannot re-include a file inside
# an excluded directory, so `data/captures/` would have made the negation below
# silently inert.
data/captures/*
# ...except the reachability report. It is small, it is the artifact we re-run
# and diff against, and a capture archive is not the same kind of thing as a
# measurement of whether capturing is possible at all.
!data/captures/reachability.json
# Manual captures are NOT reproducible — nobody can re-run a person saving a
# page from a browser they were sitting at. The provenance is therefore
# versioned even though the bytes are not: manifests and meta stay tracked, the
# HTML itself does not. Raise this if the bytes should be versioned too; it is a
# size-versus-evidence trade and the archive is the only copy either way.
!data/captures/manual/
!data/captures/manual/**/
!data/captures/manual/**/manifest.json
!data/captures/manual/**/*.meta.json
# ...but not the saved HTML itself. The directory negations above are needed so
# git will descend at all; without this line they would re-include everything.
data/captures/manual/**/*.html
ops/fetch/node_modules
