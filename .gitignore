# airport ingest data cache + checkpoints
scripts/.oa-cache/
scripts/.ourairports-progress.json
scripts/.airport-ingest-progress.json

# local build/deploy artifacts (created when HOME is set to the repo dir)
.cache/
.config/
.gitconfig
.yarn-cache/
.npm/
ops/data/

# Local tooling: a symlink to /opt/scripts/originfacts on the build host.
# Absolute and machine-specific, so it dangles anywhere else — on Vercel it
# made `next build` fail with ENOENT stat /vercel/path0/scripts.
scripts

# Editor swap files
.*.swp

# Stage 1 capture archive — large, and reproducible by re-running the fetcher.
# Excluded per-entry, not as a directory: git cannot re-include a file inside
# an excluded directory, so `data/captures/` would have made the negation below
# silently inert.
data/captures/*
# ...except the reachability report. It is small, it is the artifact we re-run
# and diff against, and a capture archive is not the same kind of thing as a
# measurement of whether capturing is possible at all.
!data/captures/reachability.json
ops/fetch/node_modules
