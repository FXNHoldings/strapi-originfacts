{
  "name": "fxn-travel-blog",
  "version": "1.0.0",
  "private": true,
  "description": "FXN Studio travel blog \u2014 Next.js frontend for Strapi CMS",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "validate:facts": "node ops/validate-airline-facts.mjs",
    "validate:facts:fixtures": "node ops/validate-airline-facts.mjs --fixtures",
    "prebuild": "node ops/validate-airline-facts.mjs",
    "fetch": "yarn --cwd ops/fetch fetch",
    "reach": "yarn --cwd ops/fetch reach",
    "ingest-manual": "yarn --cwd ops/fetch ingest-manual"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "marked": "^15.0.3",
    "next": "^15.5.21",
    "qs": "^6.15.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.3"
  },
  "resolutions": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "qs": "^6.15.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.1",
    "@types/qs": "^6.9.17",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.17",
    "tldts": "^7.4.10",
    "typescript": "^5.7.2"
  }
}
